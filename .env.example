# Copy this file to `.env`, then keep one provider template section below.

# Shared app settings
DOCS_DIR=docs
# Comma-separated glob patterns under DOCS_DIR, for example:
# DOCS_EXCLUDE_PATTERNS=development-roadmap.md,internal/*
DOCS_EXCLUDE_PATTERNS=
INDEX_PATH=data/index/chunks.jsonl
EVAL_PATH=data/evals/sample_eval.jsonl
AGENT_RUNTIME=basic
AGENTS_MAX_TURNS=6
VECTOR_BACKEND=local
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=local-docs-rag
TOP_K=4
CHUNK_STRATEGY=markdown
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ----------------------------
# OpenAI template
# Keep this block if you want to use OpenAI directly.
# ----------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_API_STYLE=responses
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=

# Optional legacy aliases
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ----------------------------
# Qwen template
# Keep this block instead if you want to use Qwen via DashScope compatible mode.
# For Qwen, `chat_completions` is the safer default than `responses`.
# ----------------------------
# LLM_PROVIDER=qwen
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_STYLE=chat_completions
# EMBEDDING_PROVIDER=qwen
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
