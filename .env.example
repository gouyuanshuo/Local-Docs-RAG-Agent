# Copy this file to `.env`, then keep one provider template section below.

# Shared app settings
DOCS_DIR=docs
# Comma-separated glob patterns under DOCS_DIR, for example:
# DOCS_EXCLUDE_PATTERNS=development-roadmap.md,internal/*
DOCS_EXCLUDE_PATTERNS=
INDEX_PATH=data/index/chunks.jsonl
INGEST_MANIFEST_PATH=data/index/ingest_manifest.json
EVAL_PATH=data/evals/sample_eval.jsonl
AGENT_RUNTIME=basic
AGENTS_MAX_TURNS=6
# Set false to ignore HTTP_PROXY/HTTPS_PROXY/ALL_PROXY for provider and Qdrant clients.
EXTERNAL_HTTP_TRUST_ENV=true
VECTOR_BACKEND=local
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_MS=800
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=local-docs-rag
QDRANT_TIMEOUT_S=30
TOP_K=4
CHUNK_STRATEGY=markdown
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# blended | dense | lexical | hybrid_rrf
# `blended` is the original ranking and stays the default; `hybrid_rrf` fuses the
# dense and BM25 rankings and is usually the one worth comparing against it.
RETRIEVAL_STRATEGY=blended
# How deep each signal ranks before fusion. Widened automatically if TOP_K exceeds it.
RETRIEVAL_CANDIDATE_K=20
# Reciprocal-rank-fusion damping constant; 60 is the value from the original paper.
RRF_K=60
# none | llm
# Second-stage reranking. `llm` reads a wider candidate window and reorders it with one
# chat call per question, so it costs money per question and stays off by default.
RERANKER=none
# How many first-stage candidates the reranker reads. Widened if TOP_K exceeds it.
RERANK_CANDIDATE_K=20
# Optional: rank with a smaller, cheaper model than the one that answers.
RERANK_MODEL=

# ----------------------------
# OpenAI template
# Keep this block if you want to use OpenAI directly.
# ----------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_API_STYLE=responses
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_MS=800

# Optional legacy aliases
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ----------------------------
# Qwen template
# Keep this block instead if you want to use Qwen via DashScope compatible mode.
# For Qwen, `chat_completions` is the safer default than `responses`.
# ----------------------------
# LLM_PROVIDER=qwen
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_STYLE=chat_completions
# EMBEDDING_PROVIDER=qwen
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_MAX_RETRIES=2
# EMBEDDING_RETRY_BACKOFF_MS=800
